# Optional explicit Foundry endpoint override. Leave blank for automatic discovery
# from "foundry server status" (recommended).
FOUNDRY_BASE_URL=
MCP_URL=http://127.0.0.1:8000/mcp
HOST=127.0.0.1
PORT=8080

# Backend: "mcp" uses your existing MCP server; "native" calls NinjaOne API v2 directly.
AGENT_BACKEND=mcp

# Native mode credentials (not required for MCP mode).
NINJA_BASE_URL=https://app.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
# Optional override; default is https://<your-region-host>/oauth/token.
NINJA_TOKEN_URL=
NINJA_SCOPE=monitoring
# Keep 0 to use the bundled ninja_spec.json; set 1 only to refresh from NinjaOne docs.
NINJA_SPEC_REFRESH=0
# For approved POST/PUT/PATCH actions, enable Management in the NinjaOne OAuth app
# and set NINJA_SCOPE=monitoring management. Monitoring alone is read-only.
NO_THINK=0

# FOUNDRY_MODEL_PHI / FOUNDRY_MODEL_QWEN are optional legacy aliases only.
# The UI now lists the model IDs currently returned by Foundry /v1/models.
