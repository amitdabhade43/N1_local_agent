# Optional explicit Foundry endpoint override. Leave blank for automatic discovery
# from "foundry server status" (recommended).
FOUNDRY_BASE_URL=

# Default provider shown when the UI opens: foundry or gateway.
LLM_PROVIDER=foundry

# Optional OpenAI-compatible remote LLM Gateway.
# Use the API base URL (normally ending in /v1), not the full /chat/completions URL.
# Example: https://llm-gateway.example.com/v1
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
# Optional PEM CA bundle for an internal/company-issued gateway certificate.
# Leave blank to use the normal system certificate trust store.
LLM_GATEWAY_CA_BUNDLE=
# Optional fallback model ID if the gateway's /models endpoint is unavailable.
LLM_GATEWAY_MODEL=
# Optional comma-separated IDs for gateway vision models whose IDs do not say vl/vision.
LLM_GATEWAY_VISION_MODELS=
MCP_URL=http://127.0.0.1:8000/mcp
HOST=127.0.0.1
PORT=8080

# Backend: "mcp" uses your existing MCP server; "native" calls NinjaOne API v2 directly.
AGENT_BACKEND=native

# Native mode credentials (not required for MCP mode).
NINJA_BASE_URL=https://app.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
# Optional override; default is https://<your-region-host>/oauth/token.
NINJA_TOKEN_URL=
NINJA_SCOPE=monitoring
# Keep 0 to use the bundled ninja_spec.json; set 1 only to refresh from NinjaOne docs.
NINJA_SPEC_REFRESH=0
# For approved POST/PUT/PATCH actions, enable Management in the NinjaOne OAuth app
# and set NINJA_SCOPE=monitoring management. Monitoring alone is read-only.
NO_THINK=0

# FOUNDRY_MODEL_PHI / FOUNDRY_MODEL_QWEN are optional legacy aliases only.
# The UI now lists the model IDs currently returned by Foundry /v1/models.

# Native agent execution safeguards. Defaults: 20 model turns and 180 seconds.
# Maximum accepted values: 40 turns and 600 seconds.
NINJA_AGENT_MAX_STEPS=20
NINJA_AGENT_MAX_SECONDS=180

# Local API hardening. Leave N1_API_TOKEN blank for a fresh random token on every launch.
# Binding HOST to a non-loopback address is refused unless BOTH N1_API_TOKEN and
# ALLOWED_HOSTS (comma-separated hostnames the UI is served from) are set.
N1_API_TOKEN=
ALLOWED_HOSTS=
