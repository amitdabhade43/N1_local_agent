# Optional explicit Foundry endpoint override. Leave blank for automatic discovery
# from "foundry server status" (recommended).
FOUNDRY_BASE_URL=

# Default provider shown when the UI opens: foundry or gateway.
LLM_PROVIDER=foundry

# Optional OpenAI-compatible remote LLM Gateway.
# Use the API base URL (normally ending in /v1), not the full /chat/completions URL.
# Example: https://llm-gateway.example.com/v1
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
# Optional PEM CA bundle for an internal/company-issued gateway certificate.
# Leave blank to use the normal system certificate trust store.
LLM_GATEWAY_CA_BUNDLE=
# Optional fallback model ID if the gateway's /models endpoint is unavailable.
LLM_GATEWAY_MODEL=
# Optional comma-separated IDs for gateway vision models whose IDs do not say vl/vision.
LLM_GATEWAY_VISION_MODELS=
# MCP transport: stdio launches the local gateway repository as a subprocess.
# Use streamable_http only when connecting to a separately hosted HTTP MCP server.
MCP_TRANSPORT=stdio
MCP_URL=
NINJA_MCP_SERVER_DIR=../NinjaRMM-API-Gateway-MCP
# Optional explicit path to the MCP repository's .venv Python executable.
NINJA_MCP_PYTHON=

HOST=127.0.0.1
PORT=8080

# Backend: "mcp" uses the NinjaOne API Gateway MCP; "native" calls NinjaOne API v2 directly.
AGENT_BACKEND=native

# Shared NinjaOne credentials. Native uses NINJA_*; the MCP launcher maps these
# into the gateway's NINJAONE_* variables automatically.
NINJA_BASE_URL=https://eu.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
# Optional override; default is https://<your-region-host>/oauth/token.
NINJA_TOKEN_URL=
# Management is required for approved POST/PUT/PATCH operations; monitoring alone is read-only.
NINJA_SCOPE=monitoring management
# Shared HMAC secret: the Local Agent signs approvals and the MCP gateway verifies them.
# Generate a long random value locally and keep it only in your untracked .env.
NINJA_MCP_APPROVAL_SECRET=

# Optional semantic-ranking overrides. Leave blank to reuse the selected chat model
# and its dynamically discovered provider endpoint.
NINJA_MCP_LLM_BASE_URL=
NINJA_MCP_LLM_MODEL=
NINJA_MCP_LLM_API_KEY=
NINJA_MCP_LLM_TIMEOUT=20

# Keep 0 to use the bundled ninja_spec.json; set 1 only to refresh from NinjaOne docs.
NINJA_SPEC_REFRESH=0
NO_THINK=0

# FOUNDRY_MODEL_PHI / FOUNDRY_MODEL_QWEN are optional legacy aliases only.
# The UI now lists the model IDs currently returned by Foundry /v1/models.
